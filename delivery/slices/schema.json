{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/trycatchjames/gp-clinic/delivery/slices/schema.json",
  "title": "GP Clinic delivery slice",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "title",
    "kind",
    "status",
    "story",
    "spec_refs",
    "acceptance",
    "evidence",
    "risk",
    "depends_on",
    "out_of_scope"
  ],
  "properties": {
    "id": { "type": "string", "pattern": "^[A-Z][A-Z0-9]+-[0-9]{3}$" },
    "title": { "type": "string", "minLength": 8 },
    "kind": { "enum": ["story", "enablement"] },
    "status": { "enum": ["backlog", "queued", "working", "in_review", "accepted", "delivered"] },
    "capability": { "type": ["string", "null"] },
    "story": {
      "type": "object",
      "additionalProperties": false,
      "required": ["actor", "goal", "benefit"],
      "properties": {
        "actor": { "type": "string", "minLength": 2 },
        "goal": { "type": "string", "minLength": 8 },
        "benefit": { "type": "string", "minLength": 8 }
      }
    },
    "spec_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^(SPEC\\.md|spec/.+\\.md)$" }
    },
    "acceptance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scenarios", "criteria"],
      "properties": {
        "scenarios": {
          "type": "array",
          "maxItems": 3,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["file", "name"],
            "properties": {
              "file": { "type": "string", "pattern": "^spec/capabilities/[^/]+/acceptance\\.feature$" },
              "name": { "type": "string", "minLength": 4 }
            }
          }
        },
        "criteria": {
          "type": "array",
          "items": { "type": "string", "minLength": 8 }
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["screenshots", "flows", "fixtures"],
      "properties": {
        "screenshots": { "$ref": "#/$defs/evidenceIds" },
        "flows": { "$ref": "#/$defs/evidenceIds" },
        "fixtures": { "$ref": "#/$defs/evidenceIds" }
      }
    },
    "risk": {
      "type": "object",
      "additionalProperties": false,
      "required": ["permissions", "clinical_safety", "data_migration", "domains"],
      "properties": {
        "permissions": { "type": "boolean" },
        "clinical_safety": { "type": "boolean" },
        "data_migration": { "type": "boolean" },
        "domains": { "type": "array", "uniqueItems": true, "items": { "type": "string" } }
      }
    },
    "depends_on": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[A-Z][A-Z0-9]+-[0-9]{3}$" }
    },
    "out_of_scope": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 4 }
    }
  },
  "$defs": {
    "evidenceIds": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" }
    }
  }
}
