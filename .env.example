# ---------------------------------------------------------------------------
# gp-prototype environment
# Copy to .env and adjust. Never commit a real .env.
# ---------------------------------------------------------------------------

# Delivery pipeline
PIPELINE_MAX_OPEN_PRS=1

# Postgres (matches docker-compose.yml)
DATABASE_URL=postgres://gp:gp@localhost:5439/gp_prototype

# API
API_PORT=3001
API_GLOBAL_PREFIX=api
NODE_ENV=development

# Auth — prototype secrets only. Rotate for anything real.
JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_REFRESH_SECRET=dev-refresh-secret-change-me
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# Web
# Origin only — the generated SDK's paths already include the /api prefix.
# Leave empty to use the same origin (the Vite dev server proxies /api to the API).
VITE_API_URL=
